{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun index.html",
    "build": "bun run typecheck && bun run build.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run --bun oxlint"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-plugin-tailwind": "0.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
