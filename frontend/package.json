{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "start": "bun scripts/start.ts",
    "dev": "bun --hot dev.ts",
    "demo": "BUN_PUBLIC_DATA_SOURCE=fixtures PORT=3001 bun --hot dev.ts",
    "dev:static": "bun index.html",
    "build": "bun run typecheck && bun run build.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run --bun oxlint",
    "lint:fix": "bun run --bun oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:types": "bun scripts/i18n-types.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-plugin-tailwind": "0.1.2",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
